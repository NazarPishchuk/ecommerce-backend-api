# Copy to .env and replace the CHANGE_ME values with your own local secrets.
# SQL Server requires a strong password. Keep .env private.
SQLSERVER_SA_PASSWORD=CHANGE_ME_STRONG_SQL_PASSWORD
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
SEQ_ADMIN_PASSWORD=CHANGE_ME_SEQ_ADMIN_PASSWORD
JWT_KEY=CHANGE_ME_WITH_A_RANDOM_KEY_AT_LEAST_32_CHARACTERS
JWT_ISSUER=ECommerce.Api
JWT_AUDIENCE=ECommerce.Client
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# Browser-facing addresses; update these if you change the published ports.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_FAKE_PAYMENT_URL=http://localhost:8082
API_PORT=8080
PAYMENT_PORT=8081
FAKE_PAYMENT_PORT=8082
MAILPIT_UI_PORT=8025
RABBITMQ_UI_PORT=15672
SEQ_UI_PORT=5341

# Local default: Mailpit on the private Compose network, no SMTP credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_AUTHENTICATION=false
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.test
SMTP_FROM_NAME=ECommerce

# For a real SMTP provider, set its host/port, credentials, and both flags to true.
